# Generated M1-G1 fixtures and experiment evidence stay local.
/tests/fixtures/g1/*.pdf
/tests/work/
/spikes/g1/node_modules/
/spikes/g1/.cache/
/spikes/g1/dist/
/spikes/g1/src-tauri/target/
*.pyc
__pycache__/

# Formal frontend dependencies, generated resources and local build/cache.
/node_modules/
/dist/
/.cache/
/public/pdfjs/
/public/__samples/
# MuPDF.js writer assets are generated from node_modules and the local font file.
/public/mupdf/
/public/noto/
/spikes/mupdf-writer/node_modules/
/src-tauri/target/
/src-tauri/gen/
# Microsoft Fixed Version WebView2 runtime: local dependency of the fixed-runtime
# validation package only; downloaded, extracted and never committed.
/src-tauri/webview2-fixed-runtime/
/src-tauri/permissions/autogenerated/
/worker/fonts/*
# The licence text must travel with any copy of the font; the font binary does not.
!/worker/fonts/NotoSansSC-v41-OFL.txt

# Authorized personal presets: local user data, never build cache or public source.
/private/
