{
  "identifier": "reader",
  "description": "Local main reader window only; no general filesystem or shell permissions.",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "core:window:allow-destroy",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-m7-open-pending",
    "allow-check-unicode-writer",
    "allow-begin-unicode-export",
    "allow-finish-unicode-export",
    "allow-save-original-pdf",
    "allow-cancel-unicode-export",
    "allow-pick-pdfs",
    "allow-pick-workspace",
    "allow-list-workspace",
    "allow-open-workspace-pdf",
    "allow-close-workspace",
    "allow-begin-pdf-read",
    "allow-read-pdf",
    "allow-cancel-pdf-read",
    "allow-release-pdf",
    "allow-get-settings",
    "allow-set-reader-settings",
    "allow-m4-status",
    "allow-m4-bind-document",
    "allow-m4-messages",
    "allow-m4-add-message",
    "allow-m4-edit-prompt",
    "allow-m4-generate-synthetic",
    "allow-m4-delete-message",
    "allow-m4-delete-document-history",
    "allow-m4-position",
    "allow-m4-release-binding",
    "allow-m4-put-draft",
    "allow-m4-list-drafts",
    "allow-m4-drop-draft",
    "allow-m4-backup",
    "allow-m4-cache-clear",
    "allow-m4-pick-migrate-data",
    "allow-m4-get-settings",
    "allow-m4-set-settings",
    "allow-m4-list-backups",
    "allow-m4-restore-backup",
    "allow-m5-config",
    "allow-m5-chat-view",
    "allow-m5-chat-select",
    "allow-m5-chat-archive",
    "allow-m5-chat-delete",
    "allow-m5-set-config",
    "allow-m5-store-key",
    "allow-m5-delete-key",
    "allow-m5-test-connection",
    "allow-m5-index",
    "allow-m5-prepare",
    "allow-m5-images",
    "allow-m5-refine",
    "allow-m5-start",
    "allow-m5-cancel",
    "allow-m5-details",
    "allow-m6-preferences",
    "allow-m6-edit-style",
    "allow-m6-import-styles",
    "allow-m6-select-style",
    "allow-m6-delete-style-version",
    "allow-m6-set-inputs",
    "allow-m6-set-context",
    "allow-m6-mock-explain",
    "allow-m5-directory",
    "allow-m5-index-member",
    "allow-m5-source",
    "allow-pending-pdf-recovery",
    "allow-export-pdf-recovery"
  ]
}
