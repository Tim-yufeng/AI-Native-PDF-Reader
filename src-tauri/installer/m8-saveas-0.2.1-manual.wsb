<Configuration>
  <!-- Manual guest acceptance only. No automatic installer, no writable host
       mapping, no output cleanup, no network, no host application-data access. -->
  <vGPU>Disable</vGPU>
  <Networking>Disable</Networking>
  <AudioInput>Disable</AudioInput>
  <VideoInput>Disable</VideoInput>
  <ProtectedClient>Enable</ProtectedClient>
  <PrinterRedirection>Disable</PrinterRedirection>
  <ClipboardRedirection>Disable</ClipboardRedirection>
  <MemoryInMB>4096</MemoryInMB>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>D:\Projects\ai-native-pdf-reader\.cache\m8-saveas-0.2.1-package</HostFolder>
      <SandboxFolder>C:\M8ReadOnly\Package</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>cmd.exe /k chcp 65001 &amp; type "C:\M8ReadOnly\Package\ACCEPTANCE-STEPS.txt"</Command>
  </LogonCommand>
</Configuration>
